<mxfile host="app.diagrams.net">
  <diagram id="odpt-layers" name="ODPT as a city platform">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- layer bands -->
        <mxCell id="band-app" value="" style="rounded=1;arcSize=4;fillColor=#F3F5F8;strokeColor=#D0D5DD;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1140" height="130" as="geometry" /></mxCell>
        <mxCell id="band-mid" value="" style="rounded=1;arcSize=4;fillColor=#F7E6EA;strokeColor=#BC002D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1140" height="190" as="geometry" /></mxCell>
        <mxCell id="band-net" value="" style="rounded=1;arcSize=4;fillColor=#F3F5F8;strokeColor=#D0D5DD;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1140" height="90" as="geometry" /></mxCell>
        <mxCell id="band-sen" value="" style="rounded=1;arcSize=4;fillColor=#F3F5F8;strokeColor=#D0D5DD;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="1140" height="140" as="geometry" /></mxCell>

        <mxCell id="lab-app" value="&lt;b&gt;Application&lt;/b&gt;&lt;br&gt;analyse + inform" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#23272E;" vertex="1" parent="1"><mxGeometry x="35" y="110" width="140" height="70" as="geometry" /></mxCell>
        <mxCell id="lab-mid" value="&lt;b&gt;Middleware&lt;/b&gt;&lt;br&gt;ODPT Center&lt;br&gt;&lt;font color=&quot;#5F6672&quot;&gt;since 31 May 2019&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#23272E;" vertex="1" parent="1"><mxGeometry x="35" y="280" width="140" height="90" as="geometry" /></mxCell>
        <mxCell id="lab-net" value="&lt;b&gt;Network&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#23272E;" vertex="1" parent="1"><mxGeometry x="35" y="460" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="lab-sen" value="&lt;b&gt;Sensor&lt;/b&gt;&lt;br&gt;sense" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#23272E;" vertex="1" parent="1"><mxGeometry x="35" y="590" width="140" height="60" as="geometry" /></mxCell>

        <!-- application layer -->
        <mxCell id="app1" value="&lt;b&gt;Map apps&lt;/b&gt;&lt;br&gt;Google, Apple, Yahoo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="105" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="app2" value="&lt;b&gt;Route planners&lt;/b&gt;&lt;br&gt;Navitime, Jorudan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="105" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="app3" value="&lt;b&gt;Contest apps&lt;/b&gt;&lt;br&gt;Mini Tokyo 3D, crowding forecasts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="105" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="app4" value="&lt;b&gt;Our analysis&lt;/b&gt;&lt;br&gt;bus delays + map&lt;br&gt;(this report)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BC002D;strokeWidth=2;fontSize=12;fontColor=#23272E;" vertex="1" parent="1"><mxGeometry x="790" y="105" width="180" height="80" as="geometry" /></mxCell>

        <!-- middleware layer -->
        <mxCell id="mid-acc" value="&lt;b&gt;Accounts and licences&lt;/b&gt;&lt;br&gt;manual approval; licence set per dataset: CC BY 4.0, ODPT Basic, Challenge-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BC002D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="250" width="780" height="60" as="geometry" /></mxCell>
        <mxCell id="mid1" value="&lt;b&gt;ODPT JSON API&lt;/b&gt;&lt;br&gt;own vocabulary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BC002D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="325" width="140" height="75" as="geometry" /></mxCell>
        <mxCell id="mid2" value="&lt;b&gt;GTFS&lt;/b&gt;&lt;br&gt;timetables, stops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BC002D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="325" width="140" height="75" as="geometry" /></mxCell>
        <mxCell id="mid3" value="&lt;b&gt;GTFS-Realtime&lt;/b&gt;&lt;br&gt;positions, predictions&lt;br&gt;&lt;font color=&quot;#BC002D&quot;&gt;no delay field&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BC002D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="325" width="140" height="75" as="geometry" /></mxCell>
        <mxCell id="mid4" value="&lt;b&gt;GBFS&lt;/b&gt;&lt;br&gt;bike share" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BC002D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="325" width="140" height="75" as="geometry" /></mxCell>
        <mxCell id="mid5" value="&lt;b&gt;CKAN catalogue&lt;/b&gt;&lt;br&gt;302 datasets, 110 orgs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BC002D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="325" width="140" height="75" as="geometry" /></mxCell>

        <!-- network layer -->
        <mxCell id="net1" value="Each operator's own back-office systems upload to ODPT over the internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="460" width="780" height="50" as="geometry" /></mxCell>

        <!-- sensor layer -->
        <mxCell id="sen1" value="&lt;b&gt;Train location&lt;/b&gt;&lt;br&gt;Toei, Tokyo Metro, JR East (contest only), Keio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="575" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="sen2" value="&lt;b&gt;Bus GPS&lt;/b&gt;&lt;br&gt;~560 to 650 Toei buses in the morning rush" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="575" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="sen3" value="&lt;b&gt;Bike docks&lt;/b&gt;&lt;br&gt;Docomo, HELLO CYCLING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="575" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="sen4" value="&lt;b&gt;Static data&lt;/b&gt;&lt;br&gt;timetables, stops, fares" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="575" width="180" height="90" as="geometry" /></mxCell>

        <!-- actuators: outside the platform -->
        <mxCell id="act" value="&lt;b&gt;Actuators&lt;/b&gt;&lt;br&gt;traffic signals (MPD)&lt;br&gt;self-driving buses&lt;br&gt;&lt;font color=&quot;#BC002D&quot;&gt;not connected to ODPT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BC002D;strokeWidth=2;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="575" width="145" height="90" as="geometry" /></mxCell>

        <!-- upward flow -->
        <mxCell id="e1" style="endArrow=block;endFill=1;strokeColor=#5F6672;strokeWidth=2;" edge="1" parent="1" source="sen2" target="net1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;strokeColor=#5F6672;strokeWidth=2;" edge="1" parent="1" source="net1" target="mid3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=1;strokeColor=#5F6672;strokeWidth=2;" edge="1" parent="1" source="mid-acc" target="app2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- the missing link -->
        <mxCell id="gap" value="&lt;b&gt;missing link&lt;/b&gt;&lt;br&gt;our proposal (Section 3.4)" style="html=1;endArrow=block;endFill=1;strokeColor=#BC002D;strokeWidth=2;dashed=1;edgeStyle=orthogonalEdgeStyle;fontColor=#BC002D;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app4" target="act"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1072" y="145" /></Array></mxGeometry></mxCell>

        <mxCell id="note" value="Sources: ODPT developer site and catalogue; our own feed tests, 28 Sep to 6 Oct 2026" style="text;html=1;align=left;fontSize=11;fontColor=#5F6672;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="700" height="24" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
