<mxfile host="app.diagrams.net">
  <diagram id="proposal-loop" name="Delay-aware bus priority">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Proposed: delay-aware bus priority closes the sense / analyse / actuate loop&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6672&quot;&gt;Blue = new links we propose. Grey = pieces Tokyo already runs.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#0B2E6B;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1000" height="60" as="geometry" />
        </mxCell>

        <!-- centre -->
        <mxCell id="hub" value="&lt;b&gt;Late Toei bus&lt;/b&gt;&lt;br&gt;3+ min behind timetable&lt;br&gt;&lt;font color=&quot;#C9D8F0&quot;&gt;30% of buses at 07:22,&lt;br&gt;30 Sep 2026 (our data)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0B2E6B;strokeColor=#0B2E6B;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="410" y="300" width="230" height="150" as="geometry" />
        </mxCell>

        <!-- four stages -->
        <mxCell id="sense" value="&lt;b&gt;1. SENSE&lt;/b&gt;&lt;br&gt;Toei live bus feed via ODPT&lt;br&gt;position every 10 to 30 s&lt;br&gt;&lt;i&gt;exists today, open, no key&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="90" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="analyse" value="&lt;b&gt;2. ANALYSE&lt;/b&gt;&lt;br&gt;delay = time seen at stop&lt;br&gt;minus timetable time&lt;br&gt;&lt;i&gt;new: prototyped in our script&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2F7BD6;strokeWidth=3;fontSize=13;fontColor=#0B2E6B;" vertex="1" parent="1">
          <mxGeometry x="760" y="325" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="actuate" value="&lt;b&gt;3. ACTUATE&lt;/b&gt;&lt;br&gt;police signal centre grants a&lt;br&gt;short, capped green extension&lt;br&gt;&lt;i&gt;exists: PTPS, MPD AI signals&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="560" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="feedback" value="&lt;b&gt;4. FEED BACK&lt;/b&gt;&lt;br&gt;publish delays and a log of&lt;br&gt;every priority action&lt;br&gt;&lt;i&gt;new: lets anyone audit it&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2F7BD6;strokeWidth=3;fontSize=13;fontColor=#0B2E6B;" vertex="1" parent="1">
          <mxGeometry x="40" y="325" width="250" height="100" as="geometry" />
        </mxCell>

        <!-- loop arrows -->
        <mxCell id="l1" value="live positions" style="html=1;endArrow=block;endFill=1;strokeColor=#5F6672;strokeWidth=2;curved=1;fontSize=12;fontColor=#5F6672;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sense" target="analyse">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="885" y="140" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="l2" value="bus 3+ min late&lt;br&gt;near a signal" style="html=1;endArrow=block;endFill=1;strokeColor=#2F7BD6;strokeWidth=2;curved=1;fontSize=12;fontColor=#2F7BD6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="analyse" target="actuate">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="885" y="610" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="l3" value="priority given?" style="html=1;endArrow=block;endFill=1;strokeColor=#5F6672;strokeWidth=2;curved=1;fontSize=12;fontColor=#5F6672;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actuate" target="feedback">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="610" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="l4" value="next readings show&lt;br&gt;whether it worked" style="html=1;endArrow=block;endFill=1;strokeColor=#2F7BD6;strokeWidth=2;curved=1;fontSize=12;fontColor=#2F7BD6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="feedback" target="sense">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="140" /></Array></mxGeometry>
        </mxCell>

        <!-- actors -->
        <mxCell id="actors" value="&lt;b&gt;Actors (quadruple helix)&lt;/b&gt;&lt;br&gt;Government: MPD signals, TMG funds pilot&lt;br&gt;Industry: signal-system vendors&lt;br&gt;Academia: independent evaluation&lt;br&gt;Citizens: riders, open audit" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#F3F5F8;strokeColor=#D0D5DD;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="770" y="660" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pilot" value="&lt;b&gt;Pilot&lt;/b&gt;: route 都07 (Kinshichō to Monzen-nakachō), median 6.4 min late. Compare one month before and after, against a similar control route." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#F3F5F8;strokeColor=#D0D5DD;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="660" width="320" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
