<mxfile host="app.diagrams.net">
  <diagram id="smago-loop" name="SmaGO smart bin loop">
    <mxGraphModel dx="1100" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;font color=&quot;#5F6672&quot;&gt;Grey = what SmaGO does today. Red = the missing link we propose (P3).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#23272E;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="1000" height="30" as="geometry" />
        </mxCell>

        <!-- today's loop -->
        <mxCell id="sense" value="&lt;b&gt;1. SENSE&lt;/b&gt;&lt;br&gt;fill sensor in each bin&lt;br&gt;solar panel powers it&lt;br&gt;&lt;i&gt;exists today&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="analyse" value="&lt;b&gt;2. ANALYSE&lt;/b&gt;&lt;br&gt;cloud dashboard tracks every bin&lt;br&gt;emails staff before it is full&lt;br&gt;&lt;i&gt;exists, run by the vendor&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="actuate" value="&lt;b&gt;3. ACTUATE (people)&lt;/b&gt;&lt;br&gt;staff choose which bins to empty&lt;br&gt;a crew collects them&lt;br&gt;&lt;i&gt;exists today&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="compact" value="&lt;b&gt;ACTUATE (automatic)&lt;/b&gt;&lt;br&gt;the bin presses its own waste&lt;br&gt;holds ~5x a normal bin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23272E;strokeColor=#23272E;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="fill level, 4G/LTE" style="html=1;endArrow=block;endFill=1;strokeColor=#5F6672;strokeWidth=2;fontSize=12;fontColor=#5F6672;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sense" target="analyse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="email alert" style="html=1;endArrow=block;endFill=1;strokeColor=#5F6672;strokeWidth=2;fontSize=12;fontColor=#5F6672;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="analyse" target="actuate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="bin emptied: level resets" style="html=1;endArrow=block;endFill=1;strokeColor=#5F6672;strokeWidth=2;fontSize=12;fontColor=#5F6672;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="actuate" target="sense">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="55" /><mxPoint x="170" y="55" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="nearly full" style="html=1;endArrow=block;endFill=1;strokeColor=#5F6672;strokeWidth=2;fontSize=12;fontColor=#5F6672;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sense" target="compact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="space freed" style="html=1;endArrow=block;endFill=1;strokeColor=#5F6672;strokeWidth=2;fontSize=12;fontColor=#5F6672;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="compact" target="sense">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- the missing link (P3) -->
        <mxCell id="p3" value="&lt;b&gt;PROPOSED (P3): ward collection planning&lt;/b&gt;&lt;br&gt;fill data → next-day demand forecast&lt;br&gt;→ collection routes generated automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7E6EA;strokeColor=#BC002D;strokeWidth=3;dashed=1;fontSize=13;fontColor=#23272E;" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="missing link: data stays&lt;br&gt;with the vendor" style="html=1;endArrow=block;endFill=1;strokeColor=#BC002D;strokeWidth=2;dashed=1;fontSize=12;fontColor=#BC002D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="analyse" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="routes for&lt;br&gt;ward crews" style="html=1;endArrow=block;endFill=1;strokeColor=#BC002D;strokeWidth=2;dashed=1;fontSize=12;fontColor=#BC002D;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="actuate">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="345" /></Array></mxGeometry>
        </mxCell>

        <!-- result -->
        <mxCell id="result" value="&lt;b&gt;Result (vendor-reported)&lt;/b&gt;: Omotesando collections fell from 3-4 a day to 1 a day, about 70% fewer. 70 bins in Tokyo by Jul 2024." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#F3F5F8;strokeColor=#D0D5DD;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="660" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
